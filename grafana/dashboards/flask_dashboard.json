{
  "title": "Flask App Metrics",
  "uid": "flask-metrics",
  "refresh": "5s",
  "panels": [
    {
      "title": "Request Rate (per sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(rate(flask_http_request_total[1m])) by (method, status, path)"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Request Latency (95th percentile)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket[1m])) by (le, path))"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Error Rate (5xx/4xx)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(rate(flask_http_request_total{status=~\"[45]..\"}[1m])) by (status)"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(flask_http_request_total)"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
